<!-- res/layout/item_app.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="8dp"
    android:layout_width="wrap_content" android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon" android:layout_width="64dp" android:layout_height="64dp"/>
    <TextView
        android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:textSize="12sp"/>
</LinearLayout>
