<!-- res/layout/overlay_banner.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:padding="12dp"
    android:background="#CCFF0033"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView
        android:id="@+id/bannerText"
        android:text="Axium Overlord — Non-compliant"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
    <Button
        android:id="@+id/btnResolve"
        android:text="Resolve"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
